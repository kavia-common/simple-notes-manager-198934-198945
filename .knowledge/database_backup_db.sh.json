{"is_source_file": true, "format": "bash", "description": "A shell script for detecting and backing up various types of databases (SQLite, PostgreSQL, MySQL, MongoDB). It checks for running database processes and performs backups accordingly.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo -u postgres pg_isready", "pg_dump", "mysqladmin ping", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT}", "pg_dump -h localhost -p ${DB_PORT} -U ${DB_USER} -d ${DB_NAME} --clean --if-exists --create", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup script", "sqlite backup", "postgresql backup", "mongosh", "mysqldump", "database detection", "database backup automation"], "state": 2, "file_id": 2, "knowledge_revision": 11, "git_revision": "3b135e7c7c154b14f209347493c1ac5c13b6b719", "hash": "d7da372b768c895a33088027314656c3", "format-version": 4, "code-base-name": "database", "filename": "database/backup_db.sh", "revision_history": [{"11": "3b135e7c7c154b14f209347493c1ac5c13b6b719"}]}